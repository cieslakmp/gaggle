<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Gaggle</AssemblyName>
    <RootNamespace>Gaggle</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The one drawing this app cannot make at runtime: an executable icon is a Win32
         resource the compiler embeds, so it has to exist as a file. It is Ui/TrayIcons
         at its Ready blue, drawn on the same 32-pixel canvas. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Product>Gaggle</Product>
    <Description>Push-to-talk voice chat for Condor Soaring Simulator</Description>
    <!-- A placeholder, and deliberately not a real version. The release workflow
         passes -p:Version=<tag> so a published build is stamped from the tag it was
         built from and cannot disagree with it. A build from source says 0.0.0, which
         is true: it is not any release. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
