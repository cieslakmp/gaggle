# Gaggle code style.
#
# Codifies the conventions the existing source already follows, so the compiler
# enforces them rather than review catching them.

root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,manifest,xml}]
indent_size = 2

[*.cs]

#### Language conventions ####

# File-scoped namespaces: one less level of indentation across the whole project.
csharp_style_namespace_declarations = file_scoped:warning

# Explicit types, except where the right-hand side already names the type.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning

# Braces on their own line, and always present. In interop code an unbraced
# single-statement if is a genuine hazard.
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning

csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_lambdas = true:silent

csharp_style_prefer_primary_constructors = false:silent
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_static_local_function = true:suggestion

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_readonly_field = true:warning

# Qualify nothing with this. Field naming carries the distinction instead.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

#### Usings ####

csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

#### Naming ####

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I

# Private instance fields: _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning

# Constants and statics read as PascalCase, including private ones.
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = warning

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_pascal.severity = warning

dotnet_naming_symbols.members.applicable_kinds = class,struct,enum,property,method,event,namespace,delegate
dotnet_naming_symbols.members.applicable_accessibilities = *
dotnet_naming_rule.members_pascal.symbols = members
dotnet_naming_rule.members_pascal.style = pascal_case
dotnet_naming_rule.members_pascal.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = interface_prefix
dotnet_naming_rule.interfaces_prefixed.severity = warning

dotnet_naming_symbols.locals.applicable_kinds = local,parameter
dotnet_naming_rule.locals_camel.symbols = locals
dotnet_naming_rule.locals_camel.style = camel_case
dotnet_naming_rule.locals_camel.severity = suggestion

#### Analyser rules deliberately turned down ####
#
# Each of these fights the shape of a Win32 interop tray app rather than
# catching anything real. Anything not listed here is left at its default.

# P/Invoke declarations mirror the Win32 names and signatures exactly, on purpose:
# matching MSDN is worth more than matching .NET naming conventions.
dotnet_diagnostic.CA1707.severity = none    # Underscores in identifiers
dotnet_diagnostic.SYSLIB1054.severity = none # Prefer LibraryImport over DllImport
dotnet_diagnostic.CA1401.severity = none    # P/Invokes should not be visible

# This app is Windows-only by construction; the csproj target framework says so.
dotnet_diagnostic.CA1416.severity = none    # Platform compatibility

# A background tray app must never die because one message failed. Broad catches
# around transcription and device access are the intended behaviour.
dotnet_diagnostic.CA1031.severity = none    # Do not catch general exception types

# Nothing here is localised, and it is not going to be.
dotnet_diagnostic.CA1303.severity = none    # Do not pass literals as localised parameters
dotnet_diagnostic.CA1304.severity = none    # Specify CultureInfo
dotnet_diagnostic.CA1305.severity = none    # Specify IFormatProvider
dotnet_diagnostic.CA1310.severity = none    # Specify StringComparison for correctness
dotnet_diagnostic.CA1863.severity = none    # Use CompositeFormat
